# Default frontend: mock. NEXT_PUBLIC_* dibundel saat `next build`.
# Dokploy: isi sebagai Build Arguments, lalu rebuild frontend.
NEXT_PUBLIC_DATA_MODE=mock
NEXT_PUBLIC_API_URL=https://api.example.com

# Default runtime dari Dockerfile.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=0.0.0.0
PORT=3000
